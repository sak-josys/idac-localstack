# Copy to .env in this directory (never commit .env).
#
# LocalStack Pro reads LOCALSTACK_AUTH_TOKEN from this file — same variable docker-compose.yml uses.
# https://docs.localstack.cloud/getting-started/auth-token/
#
# S3 uploads (mirrors CI):
#   publish-airflow         → idac-airflow-bucket-local : Airflow_configs/ + "Airflow Orchestration/"
#   publish-spark-scripts   → idac-emr-bucket-local     : local/migration_transformation/artifacts/scripts/

LOCALSTACK_AUTH_TOKEN=

# Optional — workflow orchestration publish (placeholder substitution); compose default is local-dev
# OPENLINEAGE_API_KEY=local-dev

# Optional LocalStack tuning (same .env; defaults in docker-compose.yml if omitted)
# SERVICES default in compose is: s3,iam,ec2,sts,mwaa,logs,sqs (the set MWAA needs).
# Override only if you want fewer services (e.g. SERVICES=s3 to skip MWAA bootstrap).
# SERVICES=s3,iam,ec2,sts,mwaa,logs,sqs
# DEBUG=0
# PERSISTENCE=1

# Optional: absolute path to idac-dp-config/airflow/configs if your clone is not next to idac-localstack.
# Default (when unset): ../idac-dp-config/airflow/configs relative to idac-localstack/
# DP_CONFIG_AIRFLOW_CONFIGS=/Users/you/Josys/idac-dp-config/airflow/configs

# Optional: absolute path to idac-workflow-orchestration if not next to idac-localstack
# WORKFLOW_ORCHESTRATION_ROOT=/Users/you/Josys/idac-workflow-orchestration
