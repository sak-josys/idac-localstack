# Copy to .env in this directory (never commit it).

# Required: https://docs.localstack.cloud/getting-started/auth-token/
LOCALSTACK_AUTH_TOKEN=

# OPENLINEAGE_API_KEY=local-dev

# LocalStack tuning. Defaults in docker-compose.yml are usually right.
# SERVICES=s3,iam,ec2,sts,mwaa,logs,sqs,glue
# DEBUG=0
# PERSISTENCE=1

# Override if upstream clones aren't next to idac-localstack/.
# DP_CONFIG_AIRFLOW_CONFIGS=/Users/you/Josys/idac-dp-config/airflow/configs
# WORKFLOW_ORCHESTRATION_ROOT=/Users/you/Josys/idac-workflow-orchestration
# DP_CONFIG_ROOT_HOST=/Users/you/Josys/idac-dp-config

# ---------------------------------------------------------------------------
# One-time bootstrap. BOOTSTRAP=true makes clone-from-qa + setup-glue run
# on `docker compose up`; flip back to false once they've succeeded
# (LocalStack PERSISTENCE keeps S3 + Glue catalog across restarts).
#
# Optional scopes for fast iteration:
#   QA_PREFIXES   space-separated S3 prefixes under qa/ to clone (default: all layers).
#                 Example: QA_PREFIXES="qa/gold/rollup_logic/valid/_delta_log
#                                       qa/gold/rollup_logic/valid/organization_id=6"
#   GLUE_SECTIONS layers to register (default: bronze silver gold common).
#                 Example: GLUE_SECTIONS="gold"
#   GLUE_TABLES   table-name whitelist (default: all).
#                 Example: GLUE_TABLES="rollup_logic target_dau"
# ---------------------------------------------------------------------------
# BOOTSTRAP=false
# QA_AWS_ACCESS_KEY_ID=
# QA_AWS_SECRET_ACCESS_KEY=
# QA_AWS_SESSION_TOKEN=
# QA_AWS_REGION=ap-northeast-1
# QA_PREFIXES=
# GLUE_SECTIONS=
# GLUE_TABLES=
